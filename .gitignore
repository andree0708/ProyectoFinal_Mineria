__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.DS_Store

# Dataset original (se descarga con: python -m src.download)
data/raw/*
!data/raw/.gitkeep

# Modelos entrenados (se generan con: python -m src.train)
models/*.joblib

# Resultados generados por la app (predicciones de usuarios, exports)
data/results/*
!data/results/.gitkeep
!data/results/metrics.json
!data/results/analisis.json
!data/raw/testdata.manual.2009.06.14.csv

# Muestra preprocesada: se regenera con python -m src.train (≈ 40 MB)
data/processed/*
!data/processed/.gitkeep
